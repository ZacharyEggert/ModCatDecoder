{
  "name": "prs-modcat-decoder",
  "private": false,
	"version": "1.0.0",
	"type": "module",
	"main": "lib/index.mjs",
	"types": "lib/index.d.ts",
	"description": "A decoder for PRS MODCAT codes",
  "devDependencies": {
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
	"scripts": {
		"build": "tsc",
		"test": "bun test",
		"serve": "bunx http-server . -p 8080",
		"start": "cd ./frontend && bun run start",
		"build-frontend": "bun run build && bun run --cwd ./frontend build",
		"dev": "cd ./frontend && bun run dev",
		"postinstall": "bun install --cwd ./frontend"
	}
}
